# Copia este archivo como .env (nunca subas .env a GitHub).

# Local: External Database URL de Render + DB_SSL=true
# Producción (Render): Internal Database URL + DB_SSL=false
# Si la dejas vacía en local, la API usa una base PostgreSQL en memoria.
DATABASE_URL=
DB_SSL=true

# Orígenes permitidos por CORS, separados por coma, sin barra final.
FRONTEND_URL=http://localhost:5173

PORT=3000
