# Copia este archivo como .env (nunca subas .env a GitHub).

# Local: External Database URL de Render + DB_SSL=true
# Producción (Render): Internal Database URL + DB_SSL=false
# Si la dejas vacía en local, la API usa una base PostgreSQL en memoria.
DATABASE_URL=
DB_SSL=true

# Orígenes permitidos por CORS, separados por coma, sin barra final.
FRONTEND_URL=http://localhost:5173

PORT=3000

# Clave para firmar los tokens de sesión (JWT). En local puede quedar vacía.
# En Render es obligatoria: genera una con
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Resend: clave de API para enviar correos (opcional en local; si falta no falla la API)
RESEND_API_KEY=
# Dirección remitente verificada en Resend
EMAIL_FROM="TaskBoard <notificaciones@skillware.online>"